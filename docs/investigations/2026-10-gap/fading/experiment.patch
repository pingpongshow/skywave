+void ChannelTracker::smooth(std::vector<std::vector<cfloat>>& hOut,
+                            std::vector<double>& nvOut) const {
+  using cd = std::complex<double>;
+  const int T = numTaps_;
+  const int n = plan(family_).carriers();
+  const size_t K = gf_.size();
+  hOut.assign(K, std::vector<cfloat>(size_t(n)));
+  nvOut.assign(K, 0.0);
+  if (K == 0) return;
+  std::vector<cd> gs = gf_[K - 1], Ps = Pf_[K - 1];
+  auto emit = [&](size_t k, const std::vector<cd>& g, const std::vector<cd>& P) {
+    double hv = 0.0;
+    for (int c = 0; c < n; ++c) {
+      const cfloat* row = &basis_[size_t(c) * T];
+      cd acc(0, 0);
+      double v = 0.0;
+      for (int t = 0; t < T; ++t) {
+        cd rt(row[t].real(), row[t].imag());
+        acc += rt * g[size_t(t)];
+        cd pa(0, 0);
+        for (int u = 0; u < T; ++u) pa += P[size_t(t) * T + u] * std::conj(cd(row[u].real(), row[u].imag()));
+        v += (rt * pa).real();
+      }
+      hOut[k][size_t(c)] = cfloat(float(acc.real()), float(acc.imag()));
+      hv += std::max(v, 0.0);
+    }
+    nvOut[k] = rHist_[k] + hv / std::max(n, 1);
+  };
+  emit(K - 1, gs, Ps);
+  for (size_t kk = K - 1; kk-- > 0;) {
+    // G = rho Pf_k Pp_{k+1}^{-1}; solve Pp X = Pf_k  => G = rho X^H.
+    std::vector<cd> M = Pp_[kk + 1], X = Pf_[kk];
+    // Gaussian elimination with T right-hand sides (columns of X).
+    for (int col = 0; col < T; ++col) {
+      int piv = col;
+      for (int r = col + 1; r < T; ++r)
+        if (std::abs(M[size_t(r) * T + col]) > std::abs(M[size_t(piv) * T + col])) piv = r;
+      if (piv != col) for (int c2 = 0; c2 < T; ++c2) {
+        std::swap(M[size_t(col) * T + c2], M[size_t(piv) * T + c2]);
+        std::swap(X[size_t(col) * T + c2], X[size_t(piv) * T + c2]);
+      }
+      cd d = M[size_t(col) * T + col];
+      if (std::abs(d) < 1e-15) continue;
+      for (int c2 = 0; c2 < T; ++c2) { M[size_t(col) * T + c2] /= d; X[size_t(col) * T + c2] /= d; }
+      for (int r = 0; r < T; ++r) {
+        if (r == col) continue;
+        cd f = M[size_t(r) * T + col];
+        if (std::abs(f) == 0.0) continue;
+        for (int c2 = 0; c2 < T; ++c2) { M[size_t(r) * T + c2] -= f * M[size_t(col) * T + c2]; X[size_t(r) * T + c2] -= f * X[size_t(col) * T + c2]; }
+      }
+    }
+    std::vector<cd> G(size_t(T) * T);
+    for (int i = 0; i < T; ++i) for (int j = 0; j < T; ++j) G[size_t(i) * T + j] = rho_ * std::conj(X[size_t(j) * T + i]);
+    // gs_k = gf_k + G (gs_{k+1} - gp_{k+1})
+    std::vector<cd> dg(static_cast<size_t>(T));
+    for (int t = 0; t < T; ++t) dg[size_t(t)] = gs[size_t(t)] - gp_[kk + 1][size_t(t)];
+    std::vector<cd> gnew = gf_[kk];
+    for (int i = 0; i < T; ++i) { cd a(0, 0); for (int j = 0; j < T; ++j) a += G[size_t(i) * T + j] * dg[size_t(j)]; gnew[size_t(i)] += a; }
+    // Ps_k = Pf_k + G (Ps_{k+1} - Pp_{k+1}) G^H
+    std::vector<cd> D(size_t(T) * T), GD(size_t(T) * T);
+    for (size_t i = 0; i < D.size(); ++i) D[i] = Ps[i] - Pp_[kk + 1][i];
+    for (int i = 0; i < T; ++i) for (int j = 0; j < T; ++j) { cd a(0, 0); for (int u = 0; u < T; ++u) a += G[size_t(i) * T + u] * D[size_t(u) * T + j]; GD[size_t(i) * T + j] = a; }
+    std::vector<cd> Pnew = Pf_[kk];
+    for (int i = 0; i < T; ++i) for (int j = 0; j < T; ++j) { cd a(0, 0); for (int u = 0; u < T; ++u) a += GD[size_t(i) * T + u] * std::conj(G[size_t(j) * T + u]); Pnew[size_t(i) * T + j] += a; }
+    gs = std::move(gnew); Ps = std::move(Pnew);
