+// BPSK-input MI (bits) at per-dimension SNR gamma = A^2/sigma^2, table.
+double bpskMi(double gamma) {
+  static std::vector<double> tab;
+  if (tab.empty()) {
+    for (int i = 0; i <= 600; ++i) {
+      double gdb = -30.0 + 0.1 * i, g = std::pow(10.0, gdb / 10.0);
+      // E over y~N(A, s^2), A=1, s^2 = 1/g of log2(1+exp(-2y/s^2))
+      double s2 = 1.0 / g, s = std::sqrt(s2), acc = 0, wsum = 0;
+      for (int k = -400; k <= 400; ++k) {
+        double z = k * 0.02, w = std::exp(-0.5 * z * z);
+        double y = 1.0 + s * z, t = -2.0 * y / s2;
+        double l = t > 30 ? t / std::log(2.0) : std::log2(1.0 + std::exp(t));
+        acc += w * l; wsum += w;
+      }
+      tab.push_back(1.0 - acc / wsum);
+    }
+  }
+  double gdb = 10.0 * std::log10(std::max(gamma, 1e-12));
+  double fi = (gdb + 30.0) / 0.1;
+  if (fi <= 0) return tab.front();
+  if (fi >= 600) return tab.back();
+  int i = int(fi); double fr = fi - i;
+  return tab[size_t(i)] * (1 - fr) + tab[size_t(i + 1)] * fr;
+}
 
